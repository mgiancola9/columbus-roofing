# --- Supabase (lead database — same setup as Columbus) ---
# Project URL of the GTA Supabase project (create a fresh one, run the Columbus schema).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-GTA-PROJECT.supabase.co
# Server-side insert key. Prefer the service-role key (kept secret, never sent to the browser).
# If you'd rather mirror Columbus exactly, you can instead set NEXT_PUBLIC_SUPABASE_ANON_KEY.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- n8n webhook (instant SMS/email alert — speed-to-lead) ---
# GTA equivalent of Columbus's https://n8n.columbusroofingestimates.com/webhook/lead-alert
N8N_WEBHOOK_URL=https://n8n.gtaroofingestimates.ca/webhook/lead-alert

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
